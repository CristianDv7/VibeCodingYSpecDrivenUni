# Copia este archivo a .env y ajusta los valores antes de levantar el stack.
# El .env está en .gitignore y no se sube al repositorio.

# ── MySQL ───────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=tallerdae
MYSQL_USER=tallerdae_user
MYSQL_PASSWORD=tallerdae_pass

# ── Nginx ───────────────────────────────────────────────────────────────────
# Puerto del host donde Nginx escucha (mapea al puerto 80 del contenedor)
NGINX_PORT=80

# ── Adminer ─────────────────────────────────────────────────────────────────
# Puerto del host para la interfaz web de Adminer
ADMINER_PORT=8081
